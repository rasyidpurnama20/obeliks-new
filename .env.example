# Web + Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# GitHub bootstrap workflow only (same value as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# AI is optional. Keep disabled for a zero-cost rules-only deployment.
AI_MODE=disabled
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra

# Free-tier parser (Vercel Node.js)
SUPABASE_STORAGE_BUCKET=rps-source
SERVERLESS_PARSER_MAX_MB=10
SERVERLESS_PARSER_MAX_PAGES=80
SERVERLESS_PARSER_TIMEOUT_MS=45000

# Enhanced parser after a self-hosted server is available
PARSER_SERVICE_URL=http://localhost:8001
PARSER_SERVICE_TOKEN=
PARSER_MAX_FILE_MB=25
