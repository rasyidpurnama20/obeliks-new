# Web + Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=https://obeliks.example.ac.id
OBELIKS_ORGANIZATION_SLUG=informatika-undip
# GitHub bootstrap workflow only (same value as NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# IF UNDIP lecturer provisioning. The JSON supplies missing/overridden verified
# emails; keep it and the initial password in deployment secrets. Apply requires
# an explicit email-owner confirmation. New accounts remain unconfirmed, banned,
# suspended, and receive no organization membership until onboarding is verified.
LECTURER_EMAIL_MAP_JSON=
LECTURER_INITIAL_PASSWORD=
LECTURER_ALLOWED_EMAIL_DOMAIN_SUFFIX=undip.ac.id
LECTURER_ORGANIZATION_SLUG=informatika-undip
LECTURER_EMAILS_CONFIRMED=false
LECTURER_SEED_APPLY=false

# AI is optional. Keep disabled for a zero-cost rules-only deployment.
AI_MODE=disabled
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra

# Free-tier parser (Vercel Node.js)
SUPABASE_STORAGE_BUCKET=rps-source
SERVERLESS_PARSER_MAX_MB=10
SERVERLESS_PARSER_MAX_PAGES=80
SERVERLESS_PARSER_TIMEOUT_MS=45000

# Enhanced parser after a self-hosted server is available
PARSER_SERVICE_URL=http://localhost:8001
PARSER_SERVICE_TOKEN=
PARSER_MAX_FILE_MB=25
